# viju-erp-sync — standalone configuration.
# This app reads ONLY this file. It does not inherit the main API's .env, so it
# behaves the same whether it lives inside the Viju repo or in its own.

SYNC_PORT=3100

# --- Database -----------------------------------------------------------
# The SAME database the main Viju API writes to. The main API owns the Prisma
# migrations; this worker only ever reads and upserts. Never run migrations here.
DATABASE_URL=postgresql://user:pass@host:5432/viju

# --- ERP: YVIJUCRM / Digiwin E10 external REST API -----------------------
# Base URL is NOT in the API docs — get the actual endpoint from the ERP team.
ERP_BASE_URL=https://erp.example.com/restful/standard

# Fallback digi-key, used for any object without its own key below.
ERP_API_KEY=replace-me

# Per-object digi-keys. The ERP issues a DIFFERENT key per object; set the ones
# you have and the rest fall back to ERP_API_KEY.
ERP_API_KEY_CUSTOMER=
ERP_API_KEY_CUSTOMER_CREDIT=
ERP_API_KEY_SALES_ORDER=
ERP_API_KEY_SALES_DELIVERY=
ERP_API_KEY_SALES_RETURN=
ERP_API_KEY_COLLECTION=
ERP_API_KEY_AR_REFUND=
ERP_API_KEY_OTHER_RECEIVABLE=

# Per-METHOD digi-keys. The API doc shows a different key for every method —
# including .query vs .read of the SAME object. Keys resolve most-specific first:
#   ERP_API_KEY_<OBJECT>_QUERY  →  ERP_API_KEY_<OBJECT>  →  ERP_API_KEY
# so the object-level keys above keep working; set these only where the ERP
# issued separate keys. The sync itself uses .query exclusively.
#   ERP_API_KEY_CUSTOMER_QUERY=
#   ERP_API_KEY_CUSTOMER_READ=
#   ERP_API_KEY_SALES_ORDER_QUERY=
#   ERP_API_KEY_SALES_ORDER_READ=
#   ...same pattern for the remaining objects

# Echoed inside the `digi-host` / `digi-service` JSON headers.
ERP_SERVER_IP=127.0.0.1
ERP_PRODUCT=YVIJUCRM
ERP_HOST_VERSION=5.7
# Sent as digi-host.lang.
ERP_LANG=zh_CN
# Some gateways reject a blank/unknown User-Agent; this one was observed to
# require a recognisable value before it would respond.
ERP_USER_AGENT=python-requests/2.34.2
# Changed from CRM to dcms in the 2026-07-28 ERP update.
ERP_ACCOUNT=CRM

# The ERP is a Digiwin (Chinese) deployment: its digi-host header declares
# timezone +8 while Viju operates in +1. Confirm which timezone DOC_DATE and
# ORDER_DATE are actually returned in before trusting any date.
ERP_TIMEZONE=+8

ERP_TIMEOUT_MS=30000
ERP_MAX_RETRIES=3
ERP_PAGE_SIZE=100
# Retries for a single bad page before skipping it and continuing the sweep.
ERP_PAGE_RETRIES=3
# How many ingest sweeps run at once (1 = sequential, gentlest on a flaky DB).
ERP_INGEST_CONCURRENCY=3
# Ingest cadence: every 15 min for the first FAST_MINUTES after boot (catch-up),
# then once per SLOW_MINUTES (hourly). Projection stays on ERP_PROJECT_CRON.
ERP_INGEST_FAST_MINUTES=60
ERP_INGEST_SLOW_MINUTES=60

# Pre-flight request logging: before every ERP call, logs the service name, the
# exact headers (secrets masked) and the exact body. DEFAULTS TO TRUE. It fires
# once per request and a full sweep is thousands of requests, so set it to false
# once the integration is stable.
ERP_LOG_REQUESTS=true

# ⚠️ Prints the digi-key IN FULL in the request log instead of masked. Testing
# only — the log then contains a live credential. Turn back off afterwards.
ERP_LOG_KEY_PLAIN=false

# Legacy switch for the same logging. ERP_LOG_REQUESTS supersedes it; setting
# this to true still forces request logging on even if that one is false.
ERP_VERBOSE=false

# Logs a ready-to-run curl for every request (URL + all headers + body). ⚠️ Prints
# the REAL digi-key so the curl works. DEFAULTS TO TRUE for debugging — set to
# false before running anywhere shared so the key isn't written to logs.
ERP_LOG_CURL=false

# On startup, call every ERP query endpoint once (read-only) with step logs, so a
# single restart shows which endpoints work and which fail. DEFAULTS TO TRUE.
ERP_DEBUG_STARTUP=false

# Master kill switch. When false the worker boots and serves /health but runs
# no sync jobs — useful for deploying ahead of ERP credentials.
SYNC_ENABLED=true

# Watchdog: exit (so the process manager restarts us) after the database has
# been unreachable this many minutes. 0 disables it.
DB_WATCHDOG_MINUTES=10

# --- Projection (erp_raw → public.*) ------------------------------------
# BP_CLUSTER_CODE → Region. The ERP's cluster code is BOTH the region key and the
# tenant discriminator: the same ERP serves other companies, whose customers
# carry codes outside this map. Those are quarantined into
# erp_raw.projection_quarantine, never projected and never given a default
# region. Built-in map shown; set this only to change it.
# ERP_CLUSTER_REGION_MAP={"1":"LAGOS","2":"EASTERN","3":"SOUTH_SOUTH","4":"WESTERN","5":"NORTH"}

# Ignore the changed_at watermark and re-project the whole feed every run.
# Normally unnecessary: a job with no row in erp_raw.projection_watermark
# full-scans by itself, so the first run after a deploy backfills on its own.
# To force one later, prefer deleting that job's row:
#   DELETE FROM erp_raw.projection_watermark WHERE job = 'project:customer';
ERP_PROJECT_FULL=false

# Does the ERP own Customer.phone on customers that ALREADY exist? Per the field
# ownership table it does. Set to false if the ERP's phone data is worse than the
# app's — customers being CREATED still take their phone from the ERP (it is NOT
# NULL and it is the login), but existing customers keep the number they have.
ERP_CUSTOMER_PHONE_UPDATE=true

# Timeouts for a projection pass. The first backfill touches the whole customer
# set, so these are generous. NOTE: PrismaService pins socket_timeout=120 on the
# connection string, so the client gives up on a single statement at ~120s
# regardless — raising the statement timeout past that only helps if
# socket_timeout is raised with it.
ERP_PROJECT_STATEMENT_TIMEOUT_MS=300000
ERP_PROJECT_TX_TIMEOUT_MS=600000

# --- Viju backend API (post-run reconcile calls) ------------------------
# After a clean projection the worker POSTs to two endpoints that re-derive what
# the backend owns. Both take no body and are safe to call repeatedly:
#   POST /api/v1/erp/sync/account-balance
#   POST /api/v1/erp/sync/order-status
# The order-status one is load-bearing, not just insurance: this service does not
# write Purchase.status on update (the app's own LOADED / DISPATCHED states have
# no ERP counterpart and would be clobbered), so the backend's reconciler is what
# carries an ERP status change through. Leave both unset to skip the calls.
# VIJU_API_BASE_URL=https://api.viju.example.com
# ⚠️ This is the BACKEND's ERP_API_KEY (what it expects in x-api-key), NOT the
# ERP_API_KEY above — that one is the ERP's digi-key. Different secrets, same
# name in the two repos.
# VIJU_API_KEY=replace-me
VIJU_API_TIMEOUT_MS=30000

# Create customers whose ERP PhoneNumber is unusable (blank, or — for 1,844 of
# the 1,851 Viju distributors — shared with every other distributor) using a
# non-dialable 'erp:<CUSTOMER_CODE>' placeholder, instead of quarantining them.
# The placeholder cannot collide with a real number and cannot receive an OTP, so
# the distributor shows up in the portal's admin / regional-admin / officer views
# WITHOUT a credential anyone could log in with, and a later run replaces it the
# moment the ERP sends a real number.
# OFF by default — phone is the customer login, so inventing one is a product
# decision rather than a sync default. Turn it on to reach parity with the feed
# before the ERP's phone data is fixed.
ERP_CUSTOMER_SYNTHETIC_PHONE=false
